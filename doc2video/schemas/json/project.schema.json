{
  "$defs": {
    "ActionCue": {
      "description": "An absolute-timed director action with geometry already resolved.\n\n``area`` is normalized 0..1 against the video frame, so the renderer needs\nno knowledge of the source document's page size.",
      "properties": {
        "start": {
          "title": "Start",
          "type": "number"
        },
        "end": {
          "title": "End",
          "type": "number"
        },
        "type": {
          "$ref": "#/$defs/ActionType"
        },
        "scene_id": {
          "title": "Scene Id",
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        },
        "effect": {
          "default": "",
          "title": "Effect",
          "type": "string"
        },
        "area": {
          "anyOf": [
            {
              "$ref": "#/$defs/BBox"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        }
      },
      "required": [
        "start",
        "end",
        "type",
        "scene_id"
      ],
      "title": "ActionCue",
      "type": "object"
    },
    "ActionType": {
      "enum": [
        "zoom",
        "highlight",
        "pointer",
        "pan",
        "reset",
        "transition",
        "broll"
      ],
      "title": "ActionType",
      "type": "string"
    },
    "AudioClip": {
      "properties": {
        "scene_id": {
          "title": "Scene Id",
          "type": "string"
        },
        "start": {
          "title": "Start",
          "type": "number"
        },
        "end": {
          "title": "End",
          "type": "number"
        },
        "asset": {
          "title": "Asset",
          "type": "string"
        },
        "gain_db": {
          "default": 0.0,
          "title": "Gain Db",
          "type": "number"
        }
      },
      "required": [
        "scene_id",
        "start",
        "end",
        "asset"
      ],
      "title": "AudioClip",
      "type": "object"
    },
    "BBox": {
      "description": "Axis-aligned box in *rendered page pixel* coordinates (origin top-left).",
      "properties": {
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "w": {
          "title": "W",
          "type": "number"
        },
        "h": {
          "title": "H",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "w",
        "h"
      ],
      "title": "BBox",
      "type": "object"
    },
    "ChartFacts": {
      "description": "A chart's numbers, as the deck states them.\n\nEnough to draw the chart again and no more — the deck's own categories,\nseries, values and colours. Re-palettizing or re-scaling would make the\nvideo disagree with the slide it came from, so neither is possible here.",
      "properties": {
        "kind": {
          "default": "column",
          "title": "Kind",
          "type": "string"
        },
        "title": {
          "default": "",
          "title": "Title",
          "type": "string"
        },
        "categories": {
          "items": {
            "type": "string"
          },
          "title": "Categories",
          "type": "array"
        },
        "series": {
          "items": {
            "$ref": "#/$defs/ChartSeriesFacts"
          },
          "title": "Series",
          "type": "array"
        }
      },
      "title": "ChartFacts",
      "type": "object"
    },
    "ChartSeriesFacts": {
      "properties": {
        "name": {
          "default": "",
          "title": "Name",
          "type": "string"
        },
        "values": {
          "items": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Values",
          "type": "array"
        },
        "color": {
          "default": "",
          "title": "Color",
          "type": "string"
        }
      },
      "title": "ChartSeriesFacts",
      "type": "object"
    },
    "Degradation": {
      "description": "A step that fell back to its heuristic path, and why.\n\nThe pipeline is built to degrade rather than fail, which means a run can\nsucceed while quietly producing a much worse video. Counting these is the\nonly way that shows up in monitoring.",
      "properties": {
        "what": {
          "title": "What",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "what",
        "reason"
      ],
      "title": "Degradation",
      "type": "object"
    },
    "DiagramEdge": {
      "description": "One arrow, by the elements it actually joins.",
      "properties": {
        "source": {
          "title": "Source",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "label": {
          "default": "",
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "source",
        "target"
      ],
      "title": "DiagramEdge",
      "type": "object"
    },
    "DiagramFacts": {
      "description": "A flow on a slide, read rather than recognised.\n\nPresent only when the deck *declares* the structure: a connector in OOXML\nnames the shapes it starts and ends at, so the graph is a fact about the\nfile rather than a guess about a picture. That distinction is the whole\ngate — a diagram whose arrows are drawn as free-floating lines cannot be\nread this way, and is left as the picture it is (方案 §12、§20).",
      "properties": {
        "nodes": {
          "items": {
            "type": "string"
          },
          "title": "Nodes",
          "type": "array"
        },
        "edges": {
          "items": {
            "$ref": "#/$defs/DiagramEdge"
          },
          "title": "Edges",
          "type": "array"
        }
      },
      "title": "DiagramFacts",
      "type": "object"
    },
    "DirectorAction": {
      "description": "A camera / attention instruction at a precise time within the scene.",
      "properties": {
        "at": {
          "description": "Seconds from scene start",
          "title": "At",
          "type": "number"
        },
        "type": {
          "$ref": "#/$defs/ActionType"
        },
        "target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Element id, when applicable",
          "title": "Target"
        },
        "effect": {
          "default": "",
          "title": "Effect",
          "type": "string"
        },
        "duration": {
          "default": 2.0,
          "title": "Duration",
          "type": "number"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        }
      },
      "required": [
        "at",
        "type"
      ],
      "title": "DirectorAction",
      "type": "object"
    },
    "DocumentModel": {
      "properties": {
        "title": {
          "default": "",
          "title": "Title",
          "type": "string"
        },
        "language": {
          "default": "zh",
          "title": "Language",
          "type": "string"
        },
        "topic": {
          "default": "",
          "title": "Topic",
          "type": "string"
        },
        "summary": {
          "default": "",
          "title": "Summary",
          "type": "string"
        },
        "key_concepts": {
          "items": {
            "type": "string"
          },
          "title": "Key Concepts",
          "type": "array"
        },
        "sections": {
          "items": {
            "$ref": "#/$defs/Section"
          },
          "title": "Sections",
          "type": "array"
        },
        "pages": {
          "items": {
            "$ref": "#/$defs/DocumentPage"
          },
          "title": "Pages",
          "type": "array"
        },
        "presentation_order": {
          "items": {
            "type": "integer"
          },
          "title": "Presentation Order",
          "type": "array"
        }
      },
      "title": "DocumentModel",
      "type": "object"
    },
    "DocumentPage": {
      "properties": {
        "index": {
          "description": "1-based page / slide number",
          "title": "Index",
          "type": "integer"
        },
        "page_type": {
          "$ref": "#/$defs/PageType",
          "default": "content"
        },
        "title": {
          "default": "",
          "title": "Title",
          "type": "string"
        },
        "elements": {
          "items": {
            "$ref": "#/$defs/SlideElement"
          },
          "title": "Elements",
          "type": "array"
        },
        "diagram": {
          "anyOf": [
            {
              "$ref": "#/$defs/DiagramFacts"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "groups": {
          "items": {
            "$ref": "#/$defs/ElementGroup"
          },
          "title": "Groups",
          "type": "array"
        },
        "speaker_notes": {
          "default": "",
          "title": "Speaker Notes",
          "type": "string"
        },
        "image_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image Path"
        },
        "width": {
          "default": 0,
          "title": "Width",
          "type": "number"
        },
        "height": {
          "default": 0,
          "title": "Height",
          "type": "number"
        },
        "summary": {
          "default": "",
          "title": "Summary",
          "type": "string"
        },
        "key_points": {
          "items": {
            "type": "string"
          },
          "title": "Key Points",
          "type": "array"
        }
      },
      "required": [
        "index"
      ],
      "title": "DocumentPage",
      "type": "object"
    },
    "ElementGroup": {
      "description": "Elements that read as one thing — a card, a label with its body, a row.\n\nWritten by the understanding step, which sees the rendered page; the\ngeometric grouping in the director (`_belongs`, `_labels`, `_names_the_\nblock`, `_same_row`) reconstructs the same answer shape by shape and has\nbeen patched once per deck layout it had not met. Where a group exists it\nis authoritative; where it does not, geometry still answers.",
      "properties": {
        "members": {
          "items": {
            "type": "string"
          },
          "title": "Members",
          "type": "array"
        },
        "label": {
          "default": "",
          "title": "Label",
          "type": "string"
        }
      },
      "title": "ElementGroup",
      "type": "object"
    },
    "ElementKind": {
      "enum": [
        "title",
        "subtitle",
        "bullet",
        "paragraph",
        "image",
        "chart",
        "table",
        "number",
        "shape",
        "other"
      ],
      "title": "ElementKind",
      "type": "string"
    },
    "HistoryEntry": {
      "properties": {
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "message": {
          "default": "",
          "title": "Message",
          "type": "string"
        },
        "actions": {
          "items": {
            "type": "string"
          },
          "title": "Actions",
          "type": "array"
        },
        "changed_scenes": {
          "items": {
            "type": "string"
          },
          "title": "Changed Scenes",
          "type": "array"
        }
      },
      "title": "HistoryEntry",
      "type": "object"
    },
    "LLMCall": {
      "description": "One model call, as the vendor reported it.\n\nRecorded even when the call failed or was refused: it was billed, and a run\nthat spent tokens without producing anything is exactly what monitoring\nshould be able to see.",
      "properties": {
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "input_tokens": {
          "default": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "cache_read_tokens": {
          "default": 0,
          "title": "Cache Read Tokens",
          "type": "integer"
        },
        "cache_write_tokens": {
          "default": 0,
          "title": "Cache Write Tokens",
          "type": "integer"
        },
        "duration_s": {
          "default": 0.0,
          "title": "Duration S",
          "type": "number"
        }
      },
      "required": [
        "provider",
        "model"
      ],
      "title": "LLMCall",
      "type": "object"
    },
    "NarrationSegment": {
      "description": "A sentence-sized chunk of narration, bound to the elements it talks about.\n\nThe binding is what makes the director deterministic: the model decides\n*what* is being talked about, the timing comes from TTS timestamps.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "element_refs": {
          "items": {
            "type": "string"
          },
          "title": "Element Refs",
          "type": "array"
        },
        "emphasis": {
          "default": false,
          "title": "Emphasis",
          "type": "boolean"
        },
        "start": {
          "default": 0.0,
          "title": "Start",
          "type": "number"
        },
        "end": {
          "default": 0.0,
          "title": "End",
          "type": "number"
        }
      },
      "required": [
        "id",
        "text"
      ],
      "title": "NarrationSegment",
      "type": "object"
    },
    "PageType": {
      "enum": [
        "cover",
        "agenda",
        "section",
        "content",
        "chart",
        "architecture",
        "comparison",
        "case",
        "summary",
        "contact",
        "other"
      ],
      "title": "PageType",
      "type": "string"
    },
    "PastRender": {
      "description": "A film this project made before the one it has now.\n\nKept because 「重新生成」 is a bet: the new one may be worse, and the old one\ntook twenty minutes to make. Overwriting it meant the only way back was to\nmake it again — and it might not come back the same, since the script is\nrewritten each time.",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "made_at": {
          "format": "date-time",
          "title": "Made At",
          "type": "string"
        },
        "seconds": {
          "default": 0.0,
          "title": "Seconds",
          "type": "number"
        },
        "score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        }
      },
      "required": [
        "path"
      ],
      "title": "PastRender",
      "type": "object"
    },
    "ProjectStatus": {
      "enum": [
        "created",
        "parsing",
        "writing",
        "voicing",
        "directing",
        "rendering",
        "reviewing",
        "ready",
        "failed"
      ],
      "title": "ProjectStatus",
      "type": "string"
    },
    "QualityDimension": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "score": {
          "description": "0–100",
          "title": "Score",
          "type": "number"
        },
        "weight": {
          "title": "Weight",
          "type": "number"
        },
        "detail": {
          "default": "",
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
        "name",
        "score",
        "weight"
      ],
      "title": "QualityDimension",
      "type": "object"
    },
    "QualityReport": {
      "description": "A single comparable number, plus the measurements behind it.\n\nDeliberately derived from what the review skill already measures rather\nthan from a fresh model call: a score you can only get by spending money is\na score nobody computes on every run.",
      "properties": {
        "score": {
          "default": 0.0,
          "title": "Score",
          "type": "number"
        },
        "dimensions": {
          "items": {
            "$ref": "#/$defs/QualityDimension"
          },
          "title": "Dimensions",
          "type": "array"
        },
        "errors": {
          "default": 0,
          "title": "Errors",
          "type": "integer"
        },
        "warnings": {
          "default": 0,
          "title": "Warnings",
          "type": "integer"
        }
      },
      "title": "QualityReport",
      "type": "object"
    },
    "RenderState": {
      "properties": {
        "renderer": {
          "default": "",
