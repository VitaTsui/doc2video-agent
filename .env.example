# 这个服务不持有模型，也不需要任何模型 Key：讲稿由调用方写好传进来。

# ---- TTS ----
D2V_TTS_PROVIDER=auto               # auto | macos_say | mock
D2V_TTS_VOICE=                      # 留空用系统默认音色（macos_say: 如 Tingting）
D2V_TTS_SPEECH_RATE=1.0

# ---- Renderer ----
D2V_RENDERER=auto                   # auto | remotion | ffmpeg
# ffmpeg/ffprobe 查找顺序：这里指定 > 系统 PATH > pip 内置（bundled extra）
# 留空即自动查找；用 `doc2video doctor` 可看到实际用的是哪一份
D2V_FFMPEG_PATH=
D2V_FFPROBE_PATH=
D2V_VIDEO_WIDTH=1920
D2V_VIDEO_HEIGHT=1080
D2V_VIDEO_FPS=30

# ---- 灰度 ----
# 每个特性开关的放量比例（%），按 flag:project_id 哈希决定单个工程走哪条分支。
# 留空用 core/flags.py 里的默认值。同一个工程的分支永远稳定，扩量只会新增工程。
D2V_FLAGS={}

# ---- Storage ----
# 运行总账写在 $D2V_STORAGE_DIR/runs.jsonl，`doc2video metrics` 读它
D2V_STORAGE_DIR=./storage

# ---- Server ----
D2V_HOST=0.0.0.0
D2V_PORT=8400
D2V_LOG_LEVEL=INFO
