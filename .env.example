# ---- LLM / VLM ----
# auto：先用 API Key，没有就用本机已登录的 Claude Code CLI，都没有才退化为
# 启发式规则（不调用外部服务，产出占位讲稿，用于跑通链路）
ANTHROPIC_API_KEY=
D2V_LLM_PROVIDER=auto               # auto | anthropic | claude_code | mock
D2V_LLM_MODEL=claude-opus-5
D2V_LLM_EFFORT=high                 # low | medium | high | xhigh | max（仅 anthropic）
# claude_code 专用：留空即从 PATH 找 claude
D2V_CLAUDE_CLI_PATH=
D2V_CLAUDE_CLI_TIMEOUT=600

# ---- TTS ----
D2V_TTS_PROVIDER=auto               # auto | macos_say | mock
D2V_TTS_VOICE=                      # 留空用系统默认音色（macos_say: 如 Tingting）
D2V_TTS_SPEECH_RATE=1.0

# ---- Renderer ----
D2V_RENDERER=auto                   # auto | remotion | ffmpeg
# ffmpeg/ffprobe 查找顺序：这里指定 > 系统 PATH > pip 内置（bundled extra）
# 留空即自动查找；用 `doc2video doctor` 可看到实际用的是哪一份
D2V_FFMPEG_PATH=
D2V_FFPROBE_PATH=
D2V_VIDEO_WIDTH=1920
D2V_VIDEO_HEIGHT=1080
D2V_VIDEO_FPS=30

# ---- Storage ----
# 运行总账写在 $D2V_STORAGE_DIR/runs.jsonl，`doc2video metrics` 读它
D2V_STORAGE_DIR=./storage

# ---- Server ----
D2V_HOST=0.0.0.0
D2V_PORT=8400
D2V_LOG_LEVEL=INFO
