# 默认不持有模型：讲稿由调用方（MCP 客户端）写好传进来，什么 Key 都不用配。
# 下面这一段是给「自己没有模型的调用方」准备的第二条路——比如桌面版。

# ---- 模型（可选）----
# mock  = 不用模型，等调用方给讲稿（默认）
# auto  = 依次尝试：本机 CLI Agent → anthropic → openai → gemini → compatible
# 也可以直接指定 agent_cli | anthropic | openai | gemini | compatible
D2V_LLM_PROVIDER=mock
D2V_LLM_MODEL=                      # 留空用该 provider 的默认；compatible 必须填
D2V_LLM_BASE_URL=                   # compatible 必填；其它 provider 走代理时可填
D2V_LLM_MAX_TOKENS=16000
D2V_LLM_EFFORT=high                 # 仅 anthropic：low | medium | high | xhigh | max

# 厂商 Key 用各自的惯用名，机器上已经导出过的不用再抄一份
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
D2V_COMPATIBLE_API_KEY=             # DeepSeek / 通义 / 月之暗面 / 自建网关

# ---- 把本机的 CLI Agent 当模型用（agent-virtualization）----
# 装了 Claude Code 或 Codex 的机器上，不配任何 Key 也能有模型：
#   D2V_LLM_PROVIDER=agent_cli
# 配置文件留空会自动生成一份（只允许联网、继承 HOME）。Action Space 逐轮组成：
# 纯文本的一轮什么工具都没有，带页面图的一轮开放一个看图工具，图随协议在途传给 CLI。
D2V_AGENT_CLI_RUNTIME=claude-code   # claude-code | codex
D2V_AGENT_CLI_PATH=                 # 留空按 PATH → Node 工作区 的顺序找
D2V_AGENT_CLI_CONFIG=               # 留空自动生成到 storage/agent-virtualization.json
D2V_AGENT_CLI_TIMEOUT=900

# ---- TTS ----
D2V_TTS_PROVIDER=auto               # auto | macos_say | mock
D2V_TTS_VOICE=                      # 留空用系统默认音色（macos_say: 如 Tingting）
D2V_TTS_SPEECH_RATE=1.0

# ---- Renderer ----
D2V_RENDERER=auto                   # auto | remotion | ffmpeg
# ffmpeg/ffprobe 查找顺序：这里指定 > 系统 PATH > pip 内置（bundled extra）
# 留空即自动查找；用 `doc2video doctor` 可看到实际用的是哪一份
D2V_FFMPEG_PATH=
D2V_FFPROBE_PATH=
D2V_VIDEO_WIDTH=1920
D2V_VIDEO_HEIGHT=1080
D2V_VIDEO_FPS=30

# ---- 灰度 ----
# 每个特性开关的放量比例（%），按 flag:project_id 哈希决定单个工程走哪条分支。
# 留空用 core/flags.py 里的默认值。同一个工程的分支永远稳定，扩量只会新增工程。
D2V_FLAGS={}

# ---- Storage ----
# 运行总账写在 $D2V_STORAGE_DIR/runs.jsonl，`doc2video metrics` 读它
D2V_STORAGE_DIR=./storage

# ---- Server / 鉴权 ----
# 每条路由（含 /mcp）都要 Authorization: Bearer；留空则只允许监听本机
D2V_API_TOKEN=
# 浏览器跨域来源，默认同源。别图省事写 *
D2V_CORS_ORIGINS=[]

# ---- MCP ----
D2V_MCP_ENABLED=true
# 部署到域名后必填：SDK 的 DNS-rebinding 防护默认只认 localhost，
# 域名不在这里会让所有 MCP 请求 421。匹配完整 Host 头（含端口）：
# 反代在 443 后面 ["your-host"]；直接暴露端口 ["your-host:8400"] 或 ["your-host:*"]
D2V_MCP_ALLOWED_HOSTS=[]

D2V_HOST=127.0.0.1                   # 对外暴露才改，且必须同时设 D2V_API_TOKEN
D2V_PORT=8400
D2V_LOG_LEVEL=INFO
