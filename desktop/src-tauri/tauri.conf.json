{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Doc2Video",
  "version": "0.5.0",
  "identifier": "com.vitahsu.doc2video",
  "build": {
    "frontendDist": "../web/dist",
    "devUrl": "http://localhost:5273",
    "beforeDevCommand": "pnpm --dir web dev",
    "beforeBuildCommand": "pnpm --dir web build"
  },
  "app": {
    "windows": [
      {
        "title": "Doc2Video",
        "width": 1180,
        "height": 820,
        "minWidth": 900,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: http://127.0.0.1:*; media-src 'self' http://127.0.0.1:*; connect-src 'self' http://127.0.0.1:*; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}