{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "桌面主窗口所需的最小权限：选文件、用系统播放器打开成片",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "opener:allow-open-path",
    "opener:allow-open-url",
    "updater:default",
    "process:allow-restart"
  ]
}
